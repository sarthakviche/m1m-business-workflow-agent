# Leave all of these empty for local development: no login, and the Vite proxy reaches the backend.

# The API's public URL. Empty means same origin (the Vite proxy in development).
VITE_API_BASE_URL=

# From Supabase: Project Settings → API. The publishable key is safe in the browser.
# NEVER put the secret (service role) key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true once Google is enabled under Authentication → Providers in Supabase.
VITE_AUTH_GOOGLE=false
