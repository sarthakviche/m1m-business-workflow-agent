# ─── M1M (Munim.ai) — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Accepts postgresql:// or postgresql+asyncpg:// — the backend normalises it.
DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development

# ── Sprint 1 fixed tenant ─────────────────────────────────────────────────────
# If empty, the backend falls back to the documented dev UUID:
#   a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
# Leave empty for local development against the seeded test tenant.
SPRINT_TENANT_ID=

# ── Gemini AI (Sprint 1 Step 2+) ──────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
# NEVER commit the real key — .env is always gitignored.
GEMINI_API_KEY=

# ── API keys (production auth) ────────────────────────────────────────────
# JSON map of API key → tenant UUID. Required when ENV is not development.
# MUNIM_API_KEYS={"replace-with-a-long-random-key": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}

# ── Telegram channel ──────────────────────────────────────────────────────
# Bot token from @BotFather. Local dev: python backend/scripts/telegram_bot.py poll
TELEGRAM_BOT_TOKEN=
# Production webhook only: random secret Telegram echoes back on every call.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_LINK_CODE_TTL_MINUTES=15

# ── Future Sprint 2+ variables (not needed yet) ─────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_PROVIDER=gemini
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# JWT_SECRET=
