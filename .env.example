# ============================================================
# M1M (Munim.ai) — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# --- Supabase (database + storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (use the connection pooling string from Supabase, not direct) ---
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- LLM (Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=  # Uncomment if switching provider post-MVP

# --- WhatsApp Cloud API ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Arbitrary string — must match what you enter in Meta's webhook config screen
WHATSAPP_VERIFY_TOKEN=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# OTP delivery method. 'whatsapp' uses the same Cloud API creds — no SMS vendor needed for MVP.
OTP_PROVIDER=whatsapp

# --- Runtime ---
ENV=development   # development | production
