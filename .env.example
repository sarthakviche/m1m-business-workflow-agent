# ─── M1M (Munim.ai) — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Accepts postgresql:// or postgresql+asyncpg:// — the backend normalises it.
DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres

# ── Environment ───────────────────────────────────────────────────────────────
# development = no login needed, everything runs as the seeded demo business.
# Anything else (including leaving this unset) requires login and refuses to
# start unless the production settings below are safe.
ENV=development

# ── Login (Supabase Auth) ─────────────────────────────────────────────────────
# Required when ENV is not development. https://<project-ref>.supabase.co
SUPABASE_URL=
# Only for projects still on the legacy shared-secret JWT signing key.
SUPABASE_JWT_SECRET=

# ── Web app origins allowed to call the API (comma-separated) ─────────────────
# Production: your https:// frontend origin. Empty/unset means the local dev servers.
# CORS_ORIGINS=https://munim.pages.dev

# ── Demo tenant (development only) ────────────────────────────────────────────
# If empty, the backend falls back to the documented dev UUID:
#   a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
SPRINT_TENANT_ID=

# ── Shared Gemini limit, in calls per UTC day (optional) ─────────────────────
# Over the limit, chat falls back to its rule-based parser.
# AI_DAILY_LIMIT_PER_BUSINESS=50
# AI_DAILY_LIMIT_TOTAL=200

# ── Operational (optional) ────────────────────────────────────────────────────
# SENTRY_DSN=      # error tracking, off when empty
# RATE_LIMIT_ENABLED=true
# LOG_LEVEL=INFO
# SQL_ECHO=false   # logs customer data, so only for local debugging
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2

# ── Gemini AI (Sprint 1 Step 2+) ──────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
# NEVER commit the real key — .env is always gitignored.
GEMINI_API_KEY=

# ── API keys (production auth) ────────────────────────────────────────────
# JSON map of API key → tenant UUID. Required when ENV is not development.
# MUNIM_API_KEYS={"replace-with-a-long-random-key": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"}

# ── Telegram channel ──────────────────────────────────────────────────────
# Bot token from @BotFather. Local dev: python backend/scripts/telegram_bot.py poll
TELEGRAM_BOT_TOKEN=
# Production webhook only: random secret Telegram echoes back on every call.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_LINK_CODE_TTL_MINUTES=15

# ── Future Sprint 2+ variables (not needed yet) ─────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_PROVIDER=gemini
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# JWT_SECRET=
