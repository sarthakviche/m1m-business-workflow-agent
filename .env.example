# ─── M1M (Munim.ai) — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string.
# Accepts postgresql:// or postgresql+asyncpg:// — the backend normalises it.
DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:5432/postgres

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development

# ── Sprint 1 fixed tenant ─────────────────────────────────────────────────────
# If empty, the backend falls back to the documented dev UUID:
#   a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
# Leave empty for local development against the seeded test tenant.
SPRINT_TENANT_ID=

# ── Future Sprint 2+ variables (not needed for Sprint 1) ──────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# JWT_SECRET=
